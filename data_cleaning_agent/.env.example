# Copy to .env locally. Never commit a real key. Rotate the key shared in chat.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
MISTRAL_TIMEOUT=45
INPUT_TIMEZONE=Asia/Kolkata
EXPIRY_TIMEZONE=Asia/Kolkata
EXPIRY_TIME=15:30:00
# decimal: 0.20 means 20%; percent: 20 means 20%. Never auto-detected.
IV_UNIT=decimal
# Set TIMESTAMP_UNIT=s or ms only for numeric Unix timestamps.
# TIMESTAMP_UNIT=ms
DERIVE_GREEKS=false
# Both rates must be supplied as annual decimal fractions when deriving Greeks.
# RISK_FREE_RATE=0.06
# DIVIDEND_YIELD=0.00
MAX_QUARANTINE_FRACTION=0
MAX_INPUT_MB=100
MAX_ROWS=1000000
# The requested underscore is invalid for S3 bucket names. Configure an existing bucket.
S3_BUCKET=heremesv0-cleaned-data
S3_PREFIX=cleaned
AWS_REGION=us-east-1
# AWS uses the normal boto3 credential chain (IAM role, SSO/profile, or environment).
# No AWS credentials belong in this file.

# Read-only export from the existing local Hermes database.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=hermes
POSTGRES_USER=postgres
# POSTGRES_PASSWORD= (prefer your PostgreSQL password file if required)
DAILY_PLANNER=deterministic
DAILY_READY_TIME=15:45:00
DAILY_LOOKBACK_DAYS=30
# Optional beginning of catch-up history, ISO date:
# DAILY_START_DATE=2026-09-07
# With DAILY_PLANNER=mistral the key may instead be read from macOS Keychain:
MISTRAL_KEYCHAIN_SERVICE=com.openalgo.data-cleaning-agent.mistral
